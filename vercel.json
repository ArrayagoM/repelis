      "permanent": false
    },
    {
      "source": "/android.apk",
      "destination": "https://github.com/ArrayagoM/repelis/releases/download/app-latest/lifehigh-android.apk",
      "permanent": false
    },
    {
      "source": "/viejo.apk",
      "destination": "https://github.com/ArrayagoM/repelis/releases/download/apk-latest/lifehigh.apk",
